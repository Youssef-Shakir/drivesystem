# Drive-Thru Intercom System Configuration - TEMPLATE
# -----------------------------------------------------
# Copy this file to config.yaml (untracked - see .gitignore) and edit it
# for your hardware. config.yaml is where your real PIN and device MACs
# live; keeping it out of git means they never end up in a commit or a
# public repo by accident.
#
#   cp config.yaml.example config.yaml
#
# Run `pw-cli list-objects Node` to find your device node names, and
# `bluetoothctl list` for your Bluetooth adapter's MAC.

serial:
  port: /dev/ttyUSB0
  # 9600 - the actual connected car-distance sensor (a bare ultrasonic
  # module streaming a plain "24.6\r\n" distance reading, no framing).
  # 115200 is what the esp32/sensor_node firmware uses if that's ever
  # swapped in instead - change this to match whatever's plugged in.
  baudrate: 9600
  heartbeat_timeout_sec: 15

sensor:
  # A car only counts as arrived once the 3-second-averaged distance
  # reading is inside this band - closer than detect_min_cm or farther
  # than detect_max_cm doesn't count.
  detect_min_cm: 30
  detect_max_cm: 150
  arrival_hold_sec: 1.0
  departure_hold_sec: 2.0
  # How long (sec) the raw readings must stay steady (within ~15cm of each
  # other) before they're trusted at all - a real car sitting still gives
  # a steady reading, so this rejects the sensor spiking up/down with
  # nothing actually in front of it. 0 disables this check.
  steady_sec: 2.0

audio:
  # PipeWire node names - find yours with: pw-cli list-objects Node
  # Look for alsa_input/alsa_output for USB devices, bluez for Bluetooth

  # Behringer UMC202HD (outdoor mic input after AEC processing)
  outdoor_mic: "dt_aec_source"

  # Behringer UMC202HD (horn speaker output with AEC)
  outdoor_speaker: "dt_aec_sink"

  # Bluetooth headset sink (staff ears) - M890BT
  headset_sink: "bluez_output.XX_XX_XX_XX_XX_XX.1"

  # Bluetooth headset source (staff mic) - M890BT
  headset_source: "bluez_input.XX_XX_XX_XX_XX_XX.0"

  # Which Bluetooth controller to use, by its own MAC (find with
  # `bluetoothctl list`) - NOT the headset's MAC above. Required as soon as
  # more than one adapter is plugged in: BlueZ silently makes the most
  # recently added adapter its "default", permanently, even after it's
  # powered back off - so without this, the headset can be fully paired
  # and working and every reconnect attempt still fails with
  # "Device ... not available" because it's silently targeting the wrong
  # adapter. 74:E5:F9:40:E5:8D is this box's built-in adapter.
  bluetooth_adapter: "XX:XX:XX:XX:XX:XX"

  # Raw, pre-AEC/pre-filter outdoor mic hardware input - not part of the
  # live call path, used only by the tuning recorder (see recordings:
  # below) so it has an unprocessed reference to compare against the
  # filtered output.
  raw_outdoor_mic: "alsa_input.CHANGE_ME"

  # Default volumes (0.0 - 1.5, where 1.0 = 100%) - tune these from the
  # dashboard once running; it writes the values you pick back here.
  default_volumes:
    outdoor_mic: 1.0
    outdoor_speaker: 0.8
    headset: 1.0      # staff's ears only (what plays into the headset)
    indoor_mic: 1.0    # staff's mic only (what the headset picks up from staff)

  # Audio mode: "full_duplex" or "ptt" (push-to-talk)
  default_mode: "full_duplex"

  # Path to chime sound file
  chime_path: "server/assets/chimes/urgent.wav"

denoise:
  # DeepFilterNet neural noise suppression - runs after AEC, on the
  # outdoor-mic -> headset path only (see pipewire/97-drivethru-deepfilter.conf).
  # Attenuation Limit (dB): 0 = no noise reduction, 100 = full/unlimited
  # reduction (can cut the voice mid-word - confirmed by testing). 40 is
  # the value that removed road noise without audibly clipping speech in
  # an offline A/B test against real in-car speech. Also editable live
  # from the web dashboard - that takes effect immediately; this value is
  # just what's applied at startup / after a PipeWire restart.
  attenuation_limit_db: 60.0
  # Post-filter stage - was a contributor to voice-clipping alongside a
  # too-high attenuation limit, so it ships disabled (0.0). Range is
  # 0.0-0.05 (the plugin's own max). Also live-tunable from the dashboard
  # (Settings > Mic Tuning Lab).
  post_filter_beta: 0.0

recording:
  # Records two synchronized streams to recordings/raw/ and
  # recordings/filtered/ (hourly .wav chunks) for offline AI-assisted
  # tuning of the outdoor mic's AEC/noise-filter settings - started/stopped
  # on demand from the dashboard (Settings > Mic Tuning Recording).
  # Left unset (or null): no fixed duration, records until you hit Stop.
  # Set a number of hours here instead if you want it to auto-stop itself
  # after a fixed window (and auto-start once at server boot) - in that
  # mode, restarting the service mid-window resumes the same window
  # rather than starting a new one.
  duration_hours: null

security:
  # PIN required to open the dashboard - a shared-terminal deterrent, not
  # a real security boundary. Keep this system off the public internet.
  # Pick your own numeric PIN here - this file is a template, don't leave
  # CHANGE_ME in your real config.yaml.
  pin: "CHANGE_ME"

server:
  host: "0.0.0.0"
  port: 8080

database:
  path: "drivethru.db"
