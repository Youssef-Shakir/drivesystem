"""
Permanent PipeWire-bypass bridge for the outdoor speaker.

PipeWire's own ALSA output on the built-in audio card produces distorted
("alien"/pitch-shifted) audio - confirmed by isolating it: `aplay` straight
to the same hardware sounds correct, and locking the graph's clock rate
didn't fix PipeWire's own output path. The most likely cause is the
built-in audio device's clock being dragged around by the Bluetooth SCO
link sharing the same real-time graph (see 97-drivethru-clock.conf) in a
way that's deeper than the resync clicking that fix already solved - but
regardless of the exact mechanism, going through PipeWire's ALSA sink for
this device is what's broken.

This bridges around it permanently: PipeWire keeps doing everything it's
good at (mixing, AEC, volume/mute control, the Bluetooth link) right up to
`echo-cancel-playback` - the last point confirmed clean by direct capture -
then a plain `pw-cat | aplay` pipeline hands that audio to the hardware via
raw ALSA instead of PipeWire's own output driver. Requires the built-in
audio card's PipeWire profile to be set to "off" (releasing the hardware)
for as long as this bridge runs.
"""

import logging
import re
import subprocess
import threading
import time
from typing import Optional

logger = logging.getLogger(__name__)

CAPTURE_TARGET = "echo-cancel-playback"
ALSA_HW_DEVICE = "plughw:0,0"
SAMPLE_RATE = 48000
CHANNELS = 2
RETRY_DELAY_SEC = 2.0


def _find_device_id(name_substring: str) -> Optional[int]:
    try:
        import json
        result = subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=5)
        for obj in json.loads(result.stdout):
            if obj.get("type") != "PipeWire:Interface:Device":
                continue
            props = obj.get("info", {}).get("props", {})
            if name_substring in props.get("device.name", ""):
                return obj.get("id")
    except Exception as e:
        logger.warning(f"Failed to find device '{name_substring}': {e}")
    return None


def _get_profile_index(device_id: int, profile_name: str) -> Optional[int]:
    try:
        result = subprocess.run(
            ["pw-cli", "enum-params", str(device_id), "EnumProfile"],
            capture_output=True, text=True, timeout=5,
        )
        for block in re.split(r"\n(?=  Object: size)", result.stdout):
            idx_match = re.search(r"Profile:index[^\n]*\n\s*Int (\d+)", block)
            name_match = re.search(r'Profile:name[^\n]*\n\s*String "([^"]+)"', block)
            if idx_match and name_match and name_match.group(1) == profile_name:
                return int(idx_match.group(1))
    except Exception as e:
        logger.warning(f"Failed to enumerate profiles for device {device_id}: {e}")
    return None


class OutdoorSpeakerBridge:
    """Owns the built-in audio hardware directly, bypassing PipeWire's ALSA output for it."""

    def __init__(self):
        self._stop = threading.Event()
        self._thread: Optional[threading.Thread] = None
        self._capture_proc: Optional[subprocess.Popen] = None
        self._playback_proc: Optional[subprocess.Popen] = None
        self._device_id: Optional[int] = None
        self._active = False

    def start(self) -> None:
        self._stop.clear()
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def stop(self) -> None:
        self._stop.set()
        self._teardown()
        if self._thread:
            self._thread.join(timeout=3)
        self._release_hardware()

    def is_active(self) -> bool:
        return self._active

    def _claim_hardware(self) -> bool:
        """Set the built-in audio card's PipeWire profile to off, freeing plughw:0,0 for us."""
        self._device_id = _find_device_id("alsa_card.pci-")
        if self._device_id is None:
            logger.error("Outdoor speaker bridge: couldn't find the built-in audio device")
            return False
        off_index = _get_profile_index(self._device_id, "off")
        if off_index is None:
            logger.error("Outdoor speaker bridge: couldn't find the 'off' profile")
            return False
        try:
            subprocess.run(["wpctl", "set-profile", str(self._device_id), str(off_index)],
                            capture_output=True, text=True, timeout=5, check=True)
            time.sleep(0.5)
            return True
        except Exception as e:
            logger.error(f"Outdoor speaker bridge: failed to claim hardware: {e}")
            return False

    def _release_hardware(self) -> None:
        """Hand the hardware back to PipeWire on shutdown."""
        if self._device_id is None:
            return
        restore_index = _get_profile_index(self._device_id, "output:analog-stereo+input:analog-stereo")
        if restore_index is not None:
            try:
                subprocess.run(["wpctl", "set-profile", str(self._device_id), str(restore_index)],
                                capture_output=True, text=True, timeout=5, check=True)
            except Exception as e:
                logger.error(f"Outdoor speaker bridge: failed to release hardware: {e}")

    def _teardown(self) -> None:
        for proc in (self._playback_proc, self._capture_proc):
            if proc:
                proc.terminate()
        for proc in (self._playback_proc, self._capture_proc):
            if proc:
                try:
                    proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    proc.kill()
        self._capture_proc = None
        self._playback_proc = None
        self._active = False

    def _run(self) -> None:
        while not self._stop.is_set():
            if not self._claim_hardware():
                time.sleep(RETRY_DELAY_SEC)
                continue

            try:
                self._capture_proc = subprocess.Popen(
                    ["pw-cat", "--record", "--target", CAPTURE_TARGET,
                     "--channels", str(CHANNELS), "--rate", str(SAMPLE_RATE), "--format", "s16", "-"],
                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                )
                self._playback_proc = subprocess.Popen(
                    ["aplay", "-D", ALSA_HW_DEVICE, "-f", "S16_LE",
                     "-c", str(CHANNELS), "-r", str(SAMPLE_RATE), "-"],
                    stdin=self._capture_proc.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
                self._capture_proc.stdout.close()  # let playback_proc own the read end
                self._active = True
                logger.info("Outdoor speaker bridge active (bypassing PipeWire's ALSA output)")

                # Block until either side dies, then restart the pipeline
                while not self._stop.is_set():
                    if self._capture_proc.poll() is not None or self._playback_proc.poll() is not None:
                        logger.warning("Outdoor speaker bridge pipeline died, restarting")
                        break
                    time.sleep(1)
            except FileNotFoundError as e:
                logger.error(f"Outdoor speaker bridge: required tool missing: {e}")
                return
            except Exception as e:
                logger.warning(f"Outdoor speaker bridge error: {e}")
            finally:
                self._teardown()

            if not self._stop.is_set():
                time.sleep(RETRY_DELAY_SEC)


_bridge: Optional[OutdoorSpeakerBridge] = None


def get_bridge() -> Optional[OutdoorSpeakerBridge]:
    return _bridge


def init_bridge() -> OutdoorSpeakerBridge:
    global _bridge
    _bridge = OutdoorSpeakerBridge()
    _bridge.start()
    return _bridge
